    {
      "type": "cover",
      "id": "cover",
      "heading": "房地产信贷「制度重构」：能拿房、再还贷",
      "components": [],
      "layout": "left-anchor"
    },
    {
      "type": "content",
      "id": "position",
      "heading": "定位：制度重构，而非需求刺激",
      "components": [
        {
          "type": "verdict_banner",
          "text": "不是又一轮需求端刺激，而是房地产金融从周期性调控转向制度性重构的标志性文件。",
          "tone": "neutral"
        },
        {
          "type": "row_cards",
          "items": [
            {
              "title": "文件",
              "text": "央行、金融监管总局《意见》，2026-08-28 联合印发，七章36条"
            },
            {
              "title": "主线",
              "text": "「信贷跟着交付走、资金全程封闭管」，从销售回款驱动切换为竣工交付驱动"
            },
            {
              "title": "定性",
              "text": "政策底已现、市场底未到，短期仍承压，成效取决于开发贷接续与执行刚性"
            }
          ]
        }
      ],
      "footnote": "取向：「先立制度、再稳市场」，主动适应存量时代，而非逆周期强刺激；条款以《意见》原文为准",
      "notes": "总纲页：文件性质、三条支撑主线、定性与观察锚。",
      "layout": "image-lead-split"
    },
    {
      "type": "content",
      "id": "clauses",
      "beat": "dense",
      "heading": "六条核心条款速览",
      "components": [
        {
          "type": "row_cards",
          "items": [
            {
              "title": "主办银行制度",
              "text": "单项目一家主办银行；预售最长5年、现房及商业地产最长7年；首次还本原则上在竣工备案后"
            },
            {
              "title": "按揭与开发贷衔接",
              "text": "受托支付：现房付至主办银行账户，预售付至预售资金监管账户"
            },
            {
              "title": "资金封闭管理",
              "text": "监管与定金账户须在主办银行开立，相关资金纳入主办银行账户管理"
            }
          ]
        }
      ],
      "footnote": "来源：《意见》原文 · 供给端",
      "notes": "供给端三条：主办银行、受托支付、资金封闭。",
      "layout": "stacked-poster"
    },
    {
      "type": "content",
      "id": "clauses2",
      "beat": "dense",
      "heading": "需求端与调控端：期限、时点、宏观审慎",
      "components": [
        {
          "type": "row_cards",
          "items": [
            {
              "title": "按揭期限 30→40 年",
              "text": "借贷双方协商，边际降低月供门槛"
            },
            {
              "title": "延后放款时点",
              "text": "现房备案后发放；预售严格在竣工备案后发放——「能拿房、再还贷」"
            },
            {
              "title": "宏观审慎制度化",
              "text": "首付比例、利率、贷款集中度纳入央行会同相关部门的逆周期调节机制"
            }
          ]
        }
      ],
      "footnote": "来源：《意见》原文 · 需求端与调控端",
      "notes": "需求端与调控端三条：期限、时点、宏观审慎。",
      "layout": "rail-numbered"
    },
