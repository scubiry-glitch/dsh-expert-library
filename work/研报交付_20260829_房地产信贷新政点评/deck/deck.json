    {
      "type": "content",
      "id": "consensus",
      "heading": "共识：四项研判一致",
      "components": [
        {
          "type": "row_cards",
          "items": [
            {
              "title": "制度重构定性",
              "text": "把「保交楼」事后应急转为事前制度，约束高周转预售、倒逼现房销售"
            },
            {
              "title": "风险转移至银行体系",
              "text": "期房信用风险从购房者转移至银行，消除「付了钱拿不到房」的信用坍塌点"
            },
            {
              "title": "预售回款节奏冲击",
              "text": "开发商预售现金回流锐减，需开发贷期限与还本安排同步对冲"
            },
            {
              "title": "短期不改磨底格局",
              "text": "量价双弱、利率钝化，政策底≠市场底，止跌回稳尚需时间"
            }
          ]
        }
      ],
      "footnote": "综合五位专家研判（政策制度·宏观周期视角）",
      "notes": "四项共识是主基调的支撑。",
      "layout": "narrow-column"
    },
    {
      "type": "content",
      "id": "divergence",
      "beat": "dense",
      "heading": "分歧与边界条件",
      "components": [
        {
          "type": "row_cards",
          "items": [
            {
              "title": "40年按揭实效",
              "text": "月供下降（测算：100万、3.06%，30年约4247元→40年约3614元，降约15%），但总利息增约四成，解决还贷能力而非购房能力（测算口径）"
            },
            {
              "title": "执行次序",
              "text": "放款后移若先于开发贷供给到位，对预售依赖度高的房企是「先断粮、后补粮」，短期供给收缩可能加剧（研判推断）"
            },
            {
              "title": "公积金期限错配",
              "text": "多数城市公积金上限30年，与40年商贷组合出现期限错配，组合贷产品需配套跟进"
            }
          ]
        }
      ],
      "footnote": "边界条件：任一成立，市场筑底时点需相应下修",
      "notes": "三项分歧均降级为风险提示，不改变文件定性。",
      "layout": "rail-numbered"
    },
    {
      "type": "content",
      "id": "outlook",
