# Copy to a dedicated application server after DNS and TLS are ready.
# The portal process listens on 127.0.0.1:18460 by default.
server {
    listen 80;
    listen [::]:80;
    server_name zhijian.meizu.life;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name zhijian.meizu.life;

    # Provision the certificate for this exact hostname before enabling.
    ssl_certificate     /etc/ssl/zhijian.meizu.life/fullchain.pem;
    ssl_certificate_key /etc/ssl/zhijian.meizu.life/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:18460;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_buffering off; # needed when account-scoped SSE is added
    }
}
