[Unit]
Description=Zhijian Customer Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhijian-portal
Group=zhijian-portal
WorkingDirectory=/opt/zhijian/customer-portal
EnvironmentFile=/etc/zhijian/customer-portal.env
ExecStart=/opt/zhijian/customer-portal/node /opt/zhijian/customer-portal/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Required only after enabling ACCOUNT_DB_PATH under /var/lib/zhijian/customer-portal.
# Pre-create the directory owned by zhijian-portal with mode 0700.
ReadWritePaths=/var/lib/zhijian/customer-portal

[Install]
WantedBy=multi-user.target
