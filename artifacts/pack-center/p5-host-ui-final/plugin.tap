        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '有没有L型阶段判断和有效需求视角？'
            deepDive:
              0: '是否区分止跌与回稳'
              1: '政策建议是否辩证（一步到位vs渐进）'
              2: '是否识别收储配置效率问题'
              3: '买房建议是否区分消费与投资'
            killShot: '建议京沪限购休克疗法；把收储当万能药；一刀切取消预售'
            bonusPoints:
              0: '实证数据（可支付指数/预收款30%）'
              1: '辩证框架（一步到位vs小步慢走）'
          dataPreference: '实证研究（135城数据/可支付指数）> 官方统计 > 政策文件'
          evidenceStandard: '关键结论附数据（预收款30%/存款利率1.5%/房价收入比/止跌未回稳）'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新房价收入比与可支付数据'
              1: '查政策最新表述与收储进展'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '是否有L型阶段判断'
            1: '政策建议是否辩证'
            2: '是否识别有效需求不足'
            3: '是否区分消费与投资'
          factorHierarchy:
            L型判断: 0.3
            政策辩证性: 0.25
            有效需求视角: 0.25
            消费投资区分: 0.2
          vetoRules:
            0: '建议京沪限购休克疗法'
            1: '把收储当去库存万能药'
            2: '一刀切取消预售'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论摘要'
            1: '格局判断'
            2: '关键问题'
            3: '政策批判与辩证建议'
            4: '实证支撑与购房建议'
          rubrics:
