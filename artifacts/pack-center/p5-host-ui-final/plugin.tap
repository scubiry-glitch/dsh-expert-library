              applicationContext: '长期需求与去库存'
              failureCondition: '无'
            7:
              name: '不会重演美日危机'
              summary: '无美国次贷基因（中国从未允许零首付、严格监管金融衍生品，问题本质是库存过大去产能）；无日本拖累基因（日本1990户籍城镇化77%无增长空间，中国48%还有30点空间可消化库存）'
              evidence:
