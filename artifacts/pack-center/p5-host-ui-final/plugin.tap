                  description: '只看新房单边数据'
                1:
                  score: 2
                  description: '有一二手视角但无循环分析'
                2:
                  score: 3
                  description: '循环分析到位但政策建议泛化'
                3:
                  score: 4
                  description: '总盘子+循环+因区施策齐备'
                4:
                  score: 5
                  description: '机制具体（以旧换新/货币化安置）+可验证指标全含'
