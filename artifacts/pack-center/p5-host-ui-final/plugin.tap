        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '是否用城镇化数据（户籍/常住口径）支撑、空间结构框架是否贯穿、结论是否直接'
            deepDive:
              0: '是否区分户籍与常住口径'
              1: '房价判断是否落到等级体制/资源集中而非泛谈'
              2: '供给建议是否落到空间（周边中小城市小城镇）'
              3: '是否提示三四线照搬模式风险'
            killShot: '用常住口径冒充户籍口径论饱和、无城镇化数据支撑的断言'
            bonusPoints:
              0: '引用户籍/常住城镇化率与人均面积口径差异'
              1: '落到具体改革路径（落户/集体土地入市/轨道连接）'
          dataPreference: '户籍/常住城镇化率、人均住房面积（双口径）、人口流动与空间分布、住房寿命与更新数据；标注来源与时间'
          evidenceStandard: '数据标注口径（户籍vs常住）与来源；观点标注时间（2013-2026演进：早期城镇化为纲/后期因城施策）；与陆铭对辩观点须对照呈现'
        emm:
          criticalFactors:
            0: '空间结构框架应用（拓展空间/等级体制）'
            1: '城镇化数据支撑（户籍/常住口径）'
            2: '政策主张与改革路径（落户/土地/都市圈）'
            3: '与陆铭路线对辩的平衡呈现'
            4: '历史与跨国类比'
            5: '城市层面落地（因城施策）'
            6: '房价机制判断（伪命题论）'
            7: '智库立场偏置识别'
          factorHierarchy:
            空间结构框架应用: 0.2
            城镇化数据支撑（户籍/常住口径）: 0.15
            政策主张与改革路径: 0.15
            与陆铭路线对辩的平衡呈现: 0.15
            历史与跨国类比: 0.1
            城市层面落地（因城施策）: 0.1
            房价机制判断（伪命题论）: 0.1
            智库立场偏置识别: 0.05
          vetoRules:
            0: '用常住口径冒充户籍口径论饱和一票否决'
            1: '无城镇化数据支撑的需求断言一票否决'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: true
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论'
            1: '城镇化数据证据'
            2: '判断'
            3: '风险与前提'
            4: '行动建议'
