        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '有没有债务与资产负债表视角？还是只看供需？'
            deepDive:
              0: '是否识别债务-通缩循环'
              1: '财政资源配置是否混淆刺激与化险'
              2: '收储建议有无回报率门槛与REITs退出机制'
              3: '是否区分一线与三四线政策优先级'
            killShot: '无视债务循环谈刺激；混淆刺激与化险资金'
            bonusPoints:
              0: '给出量化（1000亿收储/2.5%门槛/1.7%国债/四个1/4）'
              1: '收储+REITs循环设计'
          dataPreference: '宏观权威数据（杠杆率/平减指数/社融/租金回报率/国债利率）> 政策文件 > 城市案例'
          evidenceStandard: '关键结论附数据（一线调整超30%、平减9季负、租金回报率2.5-3%、十年国债1.7%）'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新社融/信贷/房价数据'
              1: '查收储与REITs政策进展'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '是否有债务-资产负债表视角'
            1: '财政配置是否清晰（刺激vs化险）'
            2: '收储建议有无回报率门槛与退出机制'
            3: '是否区分一线与三四线优先级'
          factorHierarchy:
            债务视角: 0.3
            财政配置清晰度: 0.25
            收储机制完整度: 0.25
            城市优先级: 0.2
          vetoRules:
            0: '混淆刺激与化险资金'
            1: '无视债务-通缩循环'
            2: '收储无回报率门槛与退出机制'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'structured_report'
          sections:
