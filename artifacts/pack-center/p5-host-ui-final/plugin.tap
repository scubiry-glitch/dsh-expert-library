          vetoRules:
            0: '建议硬着陆式调整'
            1: '把房地产当短期刺激工具'
            2: '无视资产负债表风险'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论摘要'
            1: '数据定位'
            2: '方法论检验'
            3: '趋势判断'
            4: '政策建议'
          rubrics:
