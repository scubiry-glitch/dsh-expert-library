    outputTemplates:
      0:
        id: 'zhijian.output.A'
        version: '1.1.0'
        schemaVersion: 2
        media:
          0: 'markdown'
        sections:
          0:
            id: '一句话定性'
            required: true
            minWords: 450
            maxWords: 550
            requires:
              0: 'source'
              1: 'caliber'
          1:
            id: '指标 2-3 项'
            required: true
            minWords: 450
            maxWords: 550
            requires:
              0: 'source'
              1: 'caliber'
          2:
            id: '趋势预测'
            required: true
            minWords: 450
            maxWords: 550
            requires:
              0: 'source'
              1: 'caliber'
          3:
            id: '不确定性'
            required: true
            minWords: 450
            maxWords: 550
            requires:
              0: 'source'
              1: 'caliber'
          4:
            id: '关注指标'
            required: true
            minWords: 450
            maxWords: 550
            requires:
              0: 'source'
              1: 'caliber'
        renderModes:
          discussion:
            anonymize: true
          final:
            anonymize: false
      1:
        id: 'zhijian.output.B'
        version: '1.1.0'
        schemaVersion: 2
        media:
          0: 'markdown'
        sections:
          0:
            id: '关键性结论'
            required: true
            requires:
              0: 'source'
              1: 'caliber'
          1:
            id: '关键事实及其变化'
            required: true
            requires:
              0: 'source'
              1: 'caliber'
          2:
            id: '归因分析'
            required: true
            requires:
              0: 'source'
              1: 'caliber'
          3:
            id: '收尾'
            required: true
            requires:
              0: 'source'
              1: 'caliber'
        renderModes:
          discussion:
