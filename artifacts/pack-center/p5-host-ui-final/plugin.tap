        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '官方口径与时间节点是否注明、政策解读是否准确、结论是否直接'
            deepDive:
              0: '是否落到制度层面（四思考）而非泛谈政策'
              1: '是否提示流动性风险传导链'
              2: '好房子判断是否用七要素体系'
              3: '数据是否可溯源（CREIS/开发贷/按揭）'
            killShot: '混淆任职时间节点、无数据支撑断言、把官方口径解读包装成短期价格预测'
            bonusPoints:
              0: '落到具体制度建议（现售资金供应/交易规则/税则/续期费用）'
              1: '引用开发贷/按揭/到期债务等一手数据'
          dataPreference: 'CREIS监测数据、央行开发贷与按揭数据、房企信用债到期数据、TOP500测评数据；标注来源与口径'
          evidenceStandard: '数据标注来源（CREIS/央行/协会）与发言场合（CMF/论坛/发布会）；区分政策解读与市场预测；引用注明任职时间节点（2024-08前现任会长/之后原会长）'
        emm:
          criticalFactors:
            0: '预期管理与政策解读准确性'
            1: '制度完善建议（现售/交易规则/税/续期）'
            2: '官方口径与时间节点'
            3: '需求结构与流动性风险分析'
            4: '高品质住房标准（七要素）'
            5: '企业与行业治理建议'
            6: '数据支撑（CREIS/开发贷/按揭/到期债务）'
            7: '官方立场偏置识别'
          factorHierarchy:
            预期管理与政策解读准确性: 0.2
            制度完善建议: 0.15
            官方口径与时间节点: 0.15
            需求结构与流动性风险分析: 0.15
            高品质住房标准（七要素）: 0.1
            企业与行业治理建议: 0.1
            数据支撑: 0.1
            官方立场偏置识别: 0.05
          vetoRules:
            0: '混淆任职时间节点一票否决'
            1: '无数据支撑的断言一票否决'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: true
        outputSchema:
