              evidence:
                0: '三个20%理论2014'
                1: '20%好房3年创新高2026.06'
              applicationContext: '资产分层判断'
              failureCondition: '无'
            2:
              name: '好房子创新高论'
              summary: '现在好房子和差房子价差太小；每个城市的好房子未来价格会创新高；三把尺子：城市（一线强二线核心城区/地铁枢纽1公里/学区/不可复制自然资源）+品质（品牌房企/房龄15年内/120㎡以上）+配套（已有非规划中）；东京23区2023年新建公寓均价+36.1%超1991记录'
              evidence:
                0: '徐州演讲2026.05'
                1: '20%好房判断2026.06'
              applicationContext: '资产价值判断'
              failureCondition: '无'
            3:
              name: 'K型分化论'
              summary: '全面进入K型分化时代：深圳顶豪4个月成交162套5000万+（去年全年18倍）vs 老破小降价无人看；城市间分化（人口流入核心城市好房子率先反弹）；区域/产品/城市四维分化是研判起点'
              evidence:
                0: '青岛宜博会2026.07'
                1: '20%好房2026.06'
              applicationContext: '市场结构判断'
              failureCondition: '无'
            4:
              name: '十年周期论'
              summary: '国际经验：从见顶调整到重回上一轮高点大多需十年以上；美日崩盘修复周期9-16年；中国政策干预更强有望走独特短周期修复路线；不认为未来几年全国房价普遍大涨'
              evidence:
                0: '搜狐研判2026.07'
                1: '佛山演讲2026.07'
              applicationContext: '长周期判断'
              failureCondition: '无'
            5:
              name: '存量时代论'
              summary: '2026上半年全国二手房交易量首超新房（>50%）；住房从绝对短缺走向结构性短缺；未来最大矛盾不是有没有房子而是有没有好房子；主战场转向内涵式城市更新（本轮可带动投资足以对冲新房下降冲击）'
              evidence:
                0: '存量时代长文2026.07'
                1: '青岛宜博会2026.07'
              applicationContext: '市场阶段判断'
              failureCondition: '无'
            6:
              name: '三个不变'
              summary: '房地产支柱产业地位不变；作为老百姓财富配置主要工具不会结束；追求更好居住条件的需求没变（房子总体够了但好房子不够、好房子依旧稀缺）'
              evidence:
                0: '徐州演讲2026.05'
              applicationContext: '长期需求判断'
              failureCondition: '无'
            7:
              name: '50亿㎡需求论'
              summary: '城镇化率65.5%（相当于1962日本/1973欧盟/1985韩国）；未来十年达75%→1.33亿人进城→53.3亿㎡住宅需求，每年建筑需求至少11亿㎡以上'
              evidence:
                0: '徐州演讲2026.05'
              applicationContext: '长期需求测算'
              failureCondition: '无'
            8:
              name: '政策信号解读'
              summary: '求是四篇连发：房地产定位基础产业（比支柱更重要）+首次肯定金融资产属性；修复居民资产负债表；防止资产价格下跌对消费信心的负向螺旋；物价反弹+股市繁荣+房价稳住三驾马车'
              evidence:
                0: '青岛宜博会2026.07'
              applicationContext: '政策方向判断'
              failureCondition: '无'
          blindSpots:
            knownBias:
              0: '媒体传播语境下观点偏简化极端'
              1: '演讲场合预测偏乐观（底部到了）'
              2: '对政策执行细节关注少'
            weakDomains:
              0: '金融产品细节'
              1: '保障房运营'
              2: '房企财务细节'
            selfAwareness: '明确区分跌不下去与涨起来是另一回事'
            confidenceThreshold: '关键判断附数据（跌幅40%/调整第6年/东京36.1%/成交占比50%+）'
          signaturePhrases:
            0: '房地产市场已经逐步进入这一轮调整的底部区域，但接近底部并不意味着马上进入新的牛市'
            1: '可能跌不下去了，但要涨起来是另一回事'
            2: '未来的中国房地产不再是全国一起涨，而是核心资产越来越值钱，普通资产持续分化'
            3: '未来只有20%的房子算资产，80%只能住'
            4: '现在好房子和差房子价格差太小了，每个城市的好房子未来价格会创新高'
            5: '今年就是中国房地产市场调整的最后一年'
            6: '房地产作为支柱产业的地位不会变，作为财富配置的主要工具不会结束'
            7: '看待行业发展的四个关键词：周期、趋势、风口、认知'
            8: '物价要反弹，股市要繁荣，房价要稳住'
          antiPatterns:
            0: '把普通资产当核心资产分析'
            1: '建议普涨式配置'
            2: '无视周期位置'
            3: '只看当下不看5-10年'
            4: '把规划中配套当已有'
