        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '贝壳口径/NIFD口径是否标注、微观指标是否具体、城市分层是否明确'
            deepDive:
              0: '是否区分贝壳口径与统计局口径'
              1: '挂牌/空置/周期指标是否落到具体数值'
              2: '是否识别平均数失效（结构>均值）'
              3: '修复判断是否含结构性困境（有房卖不掉）'
            killShot: '贝壳口径冒充统计局口径、无微观数据支撑的断言'
            bonusPoints:
              0: '引用具体微观指标（挂牌增长率15%/周期93天/空置率12%）'
              1: '落到城市分层（一线7%vs三线16%空置率）'
          dataPreference: '贝壳平台实时交易数据（挂牌/带看/成交/空置/周期）、NIFD房地产金融季报、房地产蓝皮书；标注贝壳口径与来源时间'
          evidenceStandard: '数据标注贝壳研究院/NIFD口径与来源（季报/蓝皮书/媒体引述）；区分平台监测数据与统计局数据；微观指标注明统计范围（百城/50城/28城）；引用《新居住发展报告2026》须注明印刷版递送政府与业界、未在网上公开发布，商密仅内部使用'
        emm:
          criticalFactors:
            0: '贝壳口径数据可核验性'
            1: '微观市场指标应用（挂牌/空置/周期）'
            2: '城市分化与结构判断'
            3: '房地产金融数据（NIFD季报）'
            4: '周期与企稳判断'
            5: '一二手联动'
            6: '数据口径区分（贝壳vs统计局vs克而瑞vs中指）'
            7: '机构立场偏置识别'
          factorHierarchy:
            贝壳口径数据可核验性: 0.2
            微观市场指标应用（挂牌/空置/周期）: 0.15
            城市分化与结构判断: 0.15
            房地产金融数据（NIFD季报）: 0.15
            周期与企稳判断: 0.1
            一二手联动: 0.1
            数据口径区分: 0.1
            机构立场偏置识别: 0.05
          vetoRules:
            0: '贝壳口径冒充统计局口径一票否决'
            1: '无微观数据支撑的市场断言一票否决'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: true
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论'
            1: '微观数据证据（贝壳口径）'
            2: '判断'
            3: '风险与前提'
            4: '行动建议'
        modelPolicy: <Circular>
        compliance:
          internalOnly: true
          citationPolicy: '贝壳/NIFD 口径'
