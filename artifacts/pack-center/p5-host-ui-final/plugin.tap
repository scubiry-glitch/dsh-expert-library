                1: '凤凰论坛2024.09'
              applicationContext: '消费结构与长期判断'
              failureCondition: '无'
            8:
              name: '价值共识流动论'
              summary: '价值载体从贝壳青铜到金银再到Labubu，价值共识随人群时代变迁；黄金共识是二战后确立；理解代际差异才能看未来资产'
