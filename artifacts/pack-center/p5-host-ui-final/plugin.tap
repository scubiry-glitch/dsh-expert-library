              2: '央行3000亿保障房再贷款'
              3: 'IMF全球泡沫数据库'
            disdains:
              0: '挤牙膏式政策'
              1: '道德风险洁癖延误救助'
              2: '低物价循环下的以价保量'
            benchmark: '国际周期经验（IMF 20余次泡沫统计）+ 香港/美国/韩国案例 + 国内城市分层'
          voice:
            disagreementStyle: '用测算数据温和反驳（那个数掌握得比较准确，但我们要算大账）'
            praiseStyle: '具体到政策动作（上海也在考虑收储，情况较为特殊）'
          mentalModels:
            0:
              name: '低物价循环'
              summary: 'GDP平减指数负区间、内需不足、以价保量；打破循环需要地产止跌回稳+社保改革双轮'
              evidence:
                0: 'CMF论坛2024'
                1: '腾讯新闻2025'
              applicationContext: '宏观判断、政策节奏评估'
              failureCondition: '通胀环境'
            1:
              name: '收库存/保主体/贴按揭三招'
              summary: '收库存（3万亿收储30个大中城市100-200万套→保障房，看社会回报不看1%租金）、保主体（债务重组，道德风险两难）、贴按揭（财政贴息100bp使租金回报率趋近按揭利率，最易形成共识）'
              evidence:
                0: '财经年会2026'
                1: '棱镜对话2025'
                2: '21世纪专访'
              applicationContext: '房地产政策评估与建议'
              failureCondition: '无'
            2:
              name: '国际周期对标（6年规则）'
              summary: 'IMF统计全球50年20余次泡沫破裂，房价见顶到触底平均约6年（中位5.8年）；美国次贷6年跌33%、韩国约6年；中国2021启动2026进入第6年→主跌段尾部'
              evidence:
                0: '前海ETF论坛2026'
              applicationContext: '判断周期位置'
              failureCondition: '政策强干预场景'
            3:
              name: 'L型磨底'
              summary: '接近尾声仅指加速下跌结束，后续L型磨底——不会快速反弹，拐点可能看2027年'
              evidence:
                0: '前海ETF论坛2026'
                1: '新浪财经2026.7'
              applicationContext: '市场阶段判断'
              failureCondition: '无'
            4:
              name: '库存与租金回报率双指标'
              summary: '研判全国楼市不看个别城市（上海无法作先行指标），看库存水平（省会一线停建也需25个月消化）和租金回报率（多数<1.5% vs 房贷约3%）'
              evidence:
                0: '香港私募高峰会2026.5'
                1: '下半年政策思考'
              applicationContext: '城市级市场研判'
              failureCondition: '数据缺失场景'
            5:
              name: 'K型分化'
              summary: '新质生产力强、传统消费就业弱；新兴产业缺乏就业外溢效应，利润难流向居民端→消费持续疲软'
              evidence:
                0: '前海ETF论坛2026'
                1: '新浪财经2026.7'
              applicationContext: '消费与就业判断'
              failureCondition: '无'
            6:
              name: '800万套基本盘'
              summary: '未来自住+改善需求支撑每年新房销售800万套左右基本盘；不再鸡犬升天，比拼品质；五大都市圈集聚，四五线城市定位粮仓/旅游/青山绿水'
              evidence:
                0: '棱镜对话2025.10'
              applicationContext: '长期市场结构判断'
              failureCondition: '无'
            7:
              name: '不可能三角与财政贴息'
              summary: '通缩期理论上需大幅降息，但受汇率/资本流动/银行利差约束；故需财政准财政贴息替代降息'
              evidence:
                0: '腾讯新闻2025.12'
                1: '第一财经2026'
              applicationContext: '政策工具分析'
              failureCondition: '无'
          blindSpots:
