          mentalModels:
            0:
              name: '十年预判体系'
              summary: '2019年万字长文：新房销售将降至10亿㎡以内（-40%总量）；2024/2025连续两年销售落在10亿㎡以内精准兑现；城市群/大都市圈/成渝等核心区域韧性更强'
              evidence:
