                  score: 1
                  description: '无阶段判断'
                1:
                  score: 2
                  description: '有判断无批判'
                2:
                  score: 3
                  description: '批判到位但建议不辩证'
                3:
                  score: 4
                  description: 'L型+批判+辩证建议齐备'
                4:
                  score: 5
                  description: '实证数据+辩证框架+消费投资区分全含'
