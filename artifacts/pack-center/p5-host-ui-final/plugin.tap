        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '有没有用一二手总盘子看市场？还是只看新房？'
            deepDive:
              0: '是否区分结构性热度与全面回暖'
              1: '循环链条（卖旧买新）是否被打通'
              2: '政策是否因区施策而非一刀切'
              3: '观察指标是否可验证'
            killShot: '把土拍高热/核心区回暖当全面复苏；无视二手房定价主导'
            bonusPoints:
              0: '给出循环修复具体机制（广州国企收购模式）'
              1: '列可验证指标清单'
          dataPreference: '统计局月度数据（销售/待售/价格指数）> 城市实操案例（广州/深圳/郑州）> 政策文件'
          evidenceStandard: '关键结论附数据（二手占比70%、18省二手超新房、100万套货币化安置、待售面积连降4个月）'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新统计局一二手交易数据'
              1: '查以旧换新与收储政策最新进展'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '是否以新房+二手房总盘子分析'
            1: '循环链条（卖旧买新）状态判断'
            2: '政策是否因区施策'
            3: '观察指标是否可验证'
          factorHierarchy:
            一二手总盘子: 0.3
            循环状态: 0.25
            因区施策: 0.25
            指标可验证: 0.2
          vetoRules:
            0: '把结构性热度当全面复苏'
            1: '无视二手房定价主导权'
            2: '主张一刀切政策（现房/限购）'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论摘要'
            1: '阶段定位'
            2: '循环分析'
            3: '政策路径'
            4: '观察指标与风险'
          rubrics:
