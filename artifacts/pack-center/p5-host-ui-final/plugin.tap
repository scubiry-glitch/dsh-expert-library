        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '有没有周期定位数据（第几年/跌幅/库存月数）？'
            deepDive:
              0: '是否区分个别城市回暖与全国指标'
              1: '政策建议有没有测算资金量与覆盖面'
              2: '是否识别道德风险与代理人问题'
              3: '结论边界是否清晰（接近尾声vs已经结束）'
            killShot: '无数据测算的见底断言；把上海回暖当全国先行指标'
            bonusPoints:
              0: '给出具体测算（3万亿收储100-200万套/贴息100bp/25个月库存）'
              1: '国际对标具体（美国6年跌33%）'
          dataPreference: '权威统计数据（统计局/IMF/央行）> 城市个案 > 传闻'
          evidenceStandard: '关键结论附测算（销售-40%、开工-60%、库存25个月、租金回报率<1.5%、800万套）'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新统计局销售/库存/房价数据'
              1: '查最新政策动态（收储/贴息进展）'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '周期位置判断是否有数据支撑（第几年/跌幅/库存）'
            1: '是否区分全国指标与个别城市'
            2: '政策建议是否测算资金与覆盖'
            3: '是否识别道德风险与执行约束'
          factorHierarchy:
            周期位置数据支撑: 0.3
            全国vs个别城市区分: 0.25
            政策测算与覆盖: 0.25
            道德风险识别: 0.2
          vetoRules:
            0: '无数据测算断言见底'
            1: '用个别城市回暖代表全国'
            2: '无视库存堰塞湖谈经济复苏'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论摘要'
            1: '周期定位'
            2: '指标拆解'
            3: '政策路径'
            4: '时间表与风险'
          rubrics:
            0:
              dimension: '周期研判力'
              levels:
                0:
                  score: 1
                  description: '情绪判断无数据'
                1:
                  score: 2
                  description: '有数据无国际对标'
                2:
                  score: 3
                  description: '有对标但政策建议无测算'
                3:
                  score: 4
                  description: '周期定位+测算+政策排序齐备'
                4:
                  score: 5
                  description: '量化测算+国际对标+执行约束+时间表全含'
