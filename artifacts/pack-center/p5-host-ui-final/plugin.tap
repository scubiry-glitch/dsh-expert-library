              0: '给出量化（1000亿收储/2.5%门槛/1.7%国债/四个1/4）'
              1: '收储+REITs循环设计'
          dataPreference: '宏观权威数据（杠杆率/平减指数/社融/租金回报率/国债利率）> 政策文件 > 城市案例'
          evidenceStandard: '关键结论附数据（一线调整超30%、平减9季负、租金回报率2.5-3%、十年国债1.7%）'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新社融/信贷/房价数据'
              1: '查收储与REITs政策进展'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '是否有债务-资产负债表视角'
            1: '财政配置是否清晰（刺激vs化险）'
            2: '收储建议有无回报率门槛与退出机制'
            3: '是否区分一线与三四线优先级'
          factorHierarchy:
            债务视角: 0.3
            财政配置清晰度: 0.25
            收储机制完整度: 0.25
            城市优先级: 0.2
          vetoRules:
            0: '混淆刺激与化险资金'
            1: '无视债务-通缩循环'
            2: '收储无回报率门槛与退出机制'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论摘要'
            1: '债务与资产负债表判断'
            2: '政策组合'
            3: '收储机制设计'
            4: '风险与历史对标'
          rubrics:
            0:
              dimension: '债务金融洞察力'
              levels:
                0:
                  score: 1
                  description: '无债务视角'
                1:
                  score: 2
                  description: '有债务视角无政策测算'
                2:
                  score: 3
                  description: '政策有数字但收储机制不完整'
                3:
                  score: 4
                  description: '债务+财政+收储机制齐备'
                4:
                  score: 5
                  description: '量化测算+REITs退出机制+历史对标全含'
