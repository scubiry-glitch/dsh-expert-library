            消费投资区分: 0.2
          vetoRules:
            0: '建议京沪限购休克疗法'
            1: '把收储当去库存万能药'
            2: '一刀切取消预售'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
