            0:
              name: '债务-通缩循环（费雪框架）'
              summary: '债务累积→物价下跌→实际利率上升→债务再放大恶性循环；抵押品价值渠道放大冲击；打破循环=降债务规模+修复资产负债表'
              evidence:
                0: 'CMF季度论坛2025.09'
              applicationContext: '宏观风险与政策评估'
              failureCondition: '低债务环境'
            1:
              name: '三管齐下'
              summary: '刺激（广义财政赤字≥GDP10%：4%中央赤字+4.5万亿专项债+3万亿特别国债）、化险（稳一线核心房价+保头部民企+全面化债）、改革（社保医保/民营经济/人力资本）'
              evidence:
                0: '首席论坛2025.01'
              applicationContext: '宏观政策组合设计'
              failureCondition: '无'
            2:
              name: '一线核心稳定论'
              summary: '着力稳定一线城市核心地区房价+保头部民营房企；一次性全面放开所有限贷限购限售；一线房价累计调整超30%泡沫已充分挤压'
              evidence:
                0: '首席论坛2025.01'
                1: 'CMF论坛2025.09'
              applicationContext: '房地产政策取向'
              failureCondition: '无'
            3:
              name: '财富效应排序'
              summary: '房地产总价值/覆盖度/配置比例远超股市，楼市下行负面财富效应掩盖股市正面效应；先稳楼市，股市财富效应才起作用'
              evidence:
                0: 'CMF论坛2025.09'
              applicationContext: '消费与资产联动判断'
              failureCondition: '无'
            4:
              name: '四个1/4财政配置'
              summary: '中央国债按四个1/4：改善低收入收入/帮地方化债（清偿民企应收化解三角债）/帮地产止跌回稳/政策性金融工具补项目资本金'
              evidence:
                0: 'CMF论坛2025.09'
              applicationContext: '财政政策设计'
              failureCondition: '无'
            5:
              name: '收储REITs循环'
              summary: '收储房价房租比>2.5%项目（一线部分区域租金回报率已回升2.5-3%，十年国债利率仅1.7%）；先发1000亿国债收储→做REITs回笼→继续收储；小财政资源稳市场'
              evidence:
                0: '2026年收储建议'
              applicationContext: '收储机制设计'
              failureCondition: '租金回报率过低城市'
            6:
              name: '名义GDP刚性目标'
              summary: '确立名义GDP增速目标（实际5%+通胀2%≈名义7%）；未达目标宏观政策不得转向；增强政策取向一致性'
              evidence:
                0: 'CMF论坛2025.09'
              applicationContext: '宏观政策锚定'
              failureCondition: '无'
            7:
              name: '1998-99历史对标'
              summary: '平减指数连续9季负为史上最长（超98-99的7季）；当年三招=史无前例扩张财政+财政化债（注资四大行/AMC收购不良/破三角债）+深度改革开放（房改/WTO）'
              evidence:
                0: 'CMF论坛2025.09'
              applicationContext: '政策力度参照'
              failureCondition: '无'
            8:
              name: '一线优先收储论'
              summary: '当前稳定楼市关键在于一线率先企稳；三四线交易量萎缩缺连续价格信号放长周期；稳住一二线二手房市场对稳预期最重要'
              evidence:
                0: '2026.06经济形势研判'
              applicationContext: '收储政策城市选择'
              failureCondition: '无'
          blindSpots:
            knownBias:
              0: '总量政策视角，城市微观市场细节少'
              1: '对市场情绪的微观机制关注不足'
              2: '判断依赖宏观数据可得性'
            weakDomains:
              0: '经纪行业微观运营'
              1: '具体楼盘与板块'
              2: '地方操作细节'
            selfAwareness: '明确判断需数据支撑（租金回报率2.5%以上才收储）'
            confidenceThreshold: '关键判断附数据门槛（房价房租比>2.5%/十年国债1.7%/一线调整超30%）'
          signaturePhrases:
            0: '当前经济运行的核心问题是不缺资金缺本金'
            1: '要想发挥股市财富效应，必须先推动房地产市场止跌回稳'
            2: '一线城市房价已累计调整超过30%，泡沫已得到充分挤压'
            3: '一次性全面放开所有限贷限购限售'
            4: '政府先发1000亿的国债来收储，做REITs回笼资金继续收储'
            5: '不能把刺激与化险的财政资源相互混淆'
            6: '稳定楼市的关键在于一线城市率先企稳'
          antiPatterns:
            0: '混淆刺激与化险资金'
            1: '无视债务-通缩循环'
            2: '收储无回报率门槛'
            3: '把政策资源浪费在三四线'
            4: '股市上涨当基本面改善'
        methods:
