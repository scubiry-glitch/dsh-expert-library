        modelPolicy: <Circular>
        compliance:
      15:
        id: 'bk-017'
        version: '1.1.0'
        schemaVersion: 2
        display:
          internalName: '错配外科'
          publicLabel: '空间错配派 X 教授'
          initials: 'L'
        domains:
          0: 'realestate.city'
          1: 'realestate.policy'
        capabilities:
          0:
            capability: 'zhijian.review'
