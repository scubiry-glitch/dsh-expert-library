              2: '政策建议是否给资金规模/利率/期限'
              3: '是否对标历史泡沫周期'
            killShot: '不看人口结构谈房价；把全国当整体谈触底'
            bonusPoints:
              0: '给出量化（5万亿/18个月去化/1.5%利率/1.07套户比）'
              1: '历史预测记录背书（一线涨一倍/历史性大顶）'
          dataPreference: '全国统计数据（人口/套户比/城镇化/去化周期/杠杆率）> 城市案例 > 历史泡沫对照'
          evidenceStandard: '关键结论附数据（套户比1.07、城镇化67%、去化26个月、杠杆率62%→59%、土地出让-31.8%）'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新人口/城镇化/套户比数据'
              1: '查收储与限购政策最新进展'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '是否先套三因子框架（人口/土地/金融）'
            1: '是否区分核心20%与低能级80%'
            2: '政策建议是否含资金规模与利率期限'
            3: '是否对标历史泡沫与软着陆条件'
          factorHierarchy:
            三因子框架: 0.3
            二八分化区分: 0.25
            政策资金测算: 0.25
            历史对标: 0.2
          vetoRules:
            0: '无视人口结构谈市场'
            1: '把80%低能级城市当核心城市分析'
            2: '主张硬着陆式急刹车'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
