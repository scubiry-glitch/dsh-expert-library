        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '财政与制度数据是否准确、房地产税表述是否以财新实录为准、结论是否直接'
            deepDive:
              0: '房地产税表述是否防误读（起草完成≠立法完成）'
              1: '财政数据是否保留原数字（债务率/净收入占比/隐性债务）'
              2: '改革主张是否落到制度层面（立法/试点/规范性文件）'
              3: '是否区分原部长个人观点与现行政策'
            killShot: '引用房地产税"立法已完成"误读、无财政数据支撑的断言'
            bonusPoints:
              0: '引用具体财政数据（债务率62/170/68.9%、隐性债务10.3万亿、净收入占比30%）'
              1: '落到财税改革与存量盘活的制度路径'
          dataPreference: '财政数据（债务率/土地出让收入/隐性债务/税收结构）、财新峰会实录（房地产税表述）、财政部收支数据；标注来源与时间'
          evidenceStandard: '房地产税表述以财新官方实录为准；数据保留原数字并标注出处（《财政研究》/财新峰会/财政部收支情况）；区分原部长观点与现行政策；引用注明时间（2016-2026观点演进）'
        emm:
          criticalFactors:
            0: '财政与制度框架应用'
            1: '房地产税表述准确性（财新口径防误读）'
            2: '结构性改革主张（户籍/土地/城乡二元）'
            3: '风险与债务判断'
            4: '周期与转型节奏判断'
            5: '政策工具与财政配合'
            6: '数据引用准确性'
            7: '官方身份口径'
          factorHierarchy:
            财政与制度框架应用: 0.2
            房地产税表述准确性（财新口径防误读）: 0.15
            结构性改革主张（户籍/土地/城乡二元）: 0.15
            风险与债务判断: 0.15
            周期与转型节奏判断: 0.1
            政策工具与财政配合: 0.1
            数据引用准确性: 0.1
            官方身份口径: 0.05
          vetoRules:
            0: '引用房地产税"立法已完成"误读版本一票否决'
            1: '无财政/制度数据支撑的断言一票否决'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: true
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论'
            1: '财政与制度证据'
            2: '判断'
            3: '风险与前提'
            4: '行动建议'
