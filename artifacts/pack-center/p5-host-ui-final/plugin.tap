        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '是否有实地调研或一手体验支撑、国际比较是否标注发展阶段差异、结论是否直接'
            deepDive:
              0: '好房子判断是否落到建造细节（防水/隔热/隔音/收口）'
              1: '日本经验类比是否克制（标注发展阶段差异）'
              2: '周期判断是否落到城市分化'
              3: '制度建议是否具体（修缮基金/三平台）'
            killShot: '机械类比日本、无调研支撑的品质断言、混淆任职时间节点'
            bonusPoints:
              0: '落到具体项目与建造细节（唐山塞纳公馆/正升收口阴阳角）'
              1: '引用一手居住体验对比（北京住宅漏水隔热）'
          dataPreference: '实地调研（"寻找中国好房子"系列：唐山/粤东正升/保利上海等）、户籍城镇化率等人口数据、中日住房品质对照体验；标注来源与时间'
          evidenceStandard: '观点标注出处场合与时间（2023前城镇化主线/2023后好房子主线）；日本经验引用须注明发展阶段差异（日本泡沫破灭于经济高度成熟期）；调研结论注明项目'
        emm:
          criticalFactors:
            0: '好房子标准与建造品质判断'
            1: '国际比较（日本经验）应用的准确与克制'
            2: '市场周期与分化判断'
            3: '官方口径与时间节点'
            4: '城镇化与居住需求结构'
            5: '制度建议（修缮基金/标准/金融差异化）'
            6: '数据与调研支撑'
            7: '日本经验类比偏置识别'
          factorHierarchy:
            好房子标准与建造品质判断: 0.2
            国际比较（日本经验）应用的准确与克制: 0.15
            市场周期与分化判断: 0.15
            官方口径与时间节点: 0.15
            城镇化与居住需求结构: 0.1
            制度建议（修缮基金/标准/金融差异化）: 0.1
            数据与调研支撑: 0.1
            日本经验类比偏置识别: 0.05
          vetoRules:
            0: '机械类比日本（忽略发展阶段差异）一票否决'
            1: '无调研/数据支撑的品质断言一票否决'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: true
        outputSchema:
          format: 'structured_report'
          sections:
            0: '结论'
            1: '体验与数据证据'
            2: '判断'
            3: '风险与前提'
            4: '行动建议'
        modelPolicy: <Circular>
        compliance:
