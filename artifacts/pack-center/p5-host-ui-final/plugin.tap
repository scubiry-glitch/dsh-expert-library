        toolAffinities:
        methodProfile:
          reviewLens:
            firstGlance: '有没有存量/分化阶段定位？还是把局部回暖当整体？'
            deepDive:
              0: '是否区分结构性企稳与全面反转'
              1: '是否用存量逻辑（运营/品质/分化）而非增量逻辑'
              2: '结论是否审慎（不做过度外推）'
            killShot: '把核心城市高端项目回暖当整体趋势'
            bonusPoints:
              0: '结构数据（分化维度/占比/库存）'
              1: '制度判断（现房/收储/REITs）'
          dataPreference: '官方统计+中指数据 > 城市个案 > 传闻'
          evidenceStandard: '关键结论附数据（销售-8%/库存正增长/二手占比55.6%/现房22.5%）或制度文件'
          agenticProtocol:
            requiresResearch: true
            researchSteps:
              0: '查最新统计局与中指数据'
              1: '查北京当期政策动态'
            noGuessPolicy: true
        emm:
          criticalFactors:
            0: '是否定位存量/分化阶段'
            1: '是否区分结构性企稳与全面反转'
            2: '是否用存量运营逻辑（产品/运营/品质）而非增量逻辑'
            3: '风险提示是否到位（库存/分化外推）'
          factorHierarchy:
            存量分化阶段定位: 0.3
            结构性vs全面区分: 0.25
            存量运营逻辑: 0.25
            风险提示: 0.2
          vetoRules:
            0: '把核心城市高端项目回暖当整体趋势'
            1: '用增量开发思维解读存量市场'
            2: '无视库存结构信号'
          aggregationLogic: 'weighted_score + 一票否决'
        constraints:
          mustConclude: true
          allowAssumption: false
        outputSchema:
          format: 'continuous_report'
          sections:
            0: '解读正文（输出为连续的一段文字，不使用任何小标题；段内按逻辑顺序自然衔接：先形势判断（当前处于什么阶段）→ 指标解读（关键指标变化及其含义）→ 趋势预测（量与价的方向判断）→ 值得关注的指标 → 主要不确定性；结论先行、每层1-2句、全文约500字（±10%）、（注：五维框架仅限「城市月度市场分析解读」话题使用）——城市月度市场解读按五维递进（一句话定性→指标解读2-3项→趋势预测落脚量价+筑底→不确定性→关注指标）、连续一段无小标题；其他一般问题按通用四段式：①关键性结论 ②关键事实及其变化分析 ③归因分析 ④收尾（更深的洞察及未来趋势展望、不确定性分析））'
          rubrics:
            0:
              dimension: '存量洞察力'
              levels:
                0:
                  score: 1
                  description: '「无阶段定位，把局部当整体」'
                1:
                  score: 2
                  description: '「有定位但无结构数据」'
                2:
                  score: 3
                  description: '「有数据但建议仍属增量思维」'
                3:
                  score: 4
                  description: '「存量定位+结构数据+运营判断齐备」'
                4:
                  score: 5
                  description: '「分化维度+制度判断+风险提示全含」'
        modelPolicy:
          provider: 'deepseek-official'
          model: 'deepseek-v4-flash'
          reasoningEffort: 'max'
        compliance:
      20:
        id: 'bk-022'
        version: '1.1.0'
        schemaVersion: 2
        display:
          internalName: '慢牛主席'
          publicLabel: '双轨慢牛派 X 主席'
          initials: 'M'
        domains:
          0: 'realestate.policy'
        capabilities:
          0:
            capability: 'zhijian.review'
            proficiency: 1
            coverage: 'medium'
            evidenceRefs:
              0: 'zhijian:roster'
          1:
            capability: 'realestate.policy.review'
            proficiency: 1
            coverage: 'high'
            evidenceRefs:
              0: 'zhijian:roster'
