              3: '一刀切政策'
            benchmark: '广东/深圳一线实操 + 全国统计局数据 + 国际存量时代经验'
          voice:
            disagreementStyle: '用数据温和修正（土拍高热不等于复苏，单宗高地价拉动有限）'
            praiseStyle: '具体到机制（国企出钱收旧房、居民安心换新房、资金安全有保障）'
          mentalModels:
            0:
              name: '存量时代三转变'
              summary: '增量转存量：二手房对价格作用增强（定价主导从房企变分散业主）、定位从发动机转稳定器、贡献模式从投资拉动转租赁/存量交易/城市更新'
              evidence:
                0: '存量时代重塑供需格局2026.07'
                1: '楼市底层逻辑变了2021'
              applicationContext: '任何市场结构判断'
              failureCondition: '增量主导时期'
            1:
              name: '一二手一体化'
              summary: '30重点城市二手房交易占比近70%，18省二手超新房；分析市场要看新房+二手房总供给总需求；二手房交易上升是常态'
              evidence:
                0: '稳楼市需政策改革突破2025.12'
                1: '存量时代专题2026.07'
              applicationContext: '城市市场研判'
              failureCondition: '无'
            2:
              name: '循环修复论'
              summary: '市场核心症结是循环不起来（卖不掉旧房就无法换新）；以旧换新关键=降低置换成本与周期+安全垫（卖不掉则无责退订）；广州试点：国企出钱收旧房、居民安心换新房、资金安全有保障'
              evidence:
                0: '以旧换新专题2024-2025'
                1: '广州收购试点2025.05'
              applicationContext: '政策设计与市场修复'
              failureCondition: '无'
            3:
              name: '探底触底阶段论'
              summary: '探底→触底→夯实底部→走出L型甚至V型；供求关系好转是根源（供地<开工<批售<销售持续去库存）；再次大幅度下调的可能性不存在了'
              evidence:
                0: '房价进入调整末端2026.05'
                1: '2026楼市展望'
              applicationContext: '周期阶段判断'
              failureCondition: '无'
            4:
              name: '因区施策控增量去库存优供给'
              summary: '以消化周期决定是否供地；好房子也要有序推动；小而美小而精项目成热点；核心区产品力升级挤压周边老旧二手房'
              evidence:
                0: '好房子政策逻辑2025.03'
                1: '土拍高热不等于复苏2025'
              applicationContext: '供给端政策评估'
              failureCondition: '无'
            5:
              name: '现房销售渐进论'
              summary: '十五五有力有序推进现房销售：所见即所得、告别高周转、中小房企小而美机会；预售现售差异缩小平稳过渡，不搞一刀切'
              evidence:
                0: '现房销售专题2025-2026'
              applicationContext: '销售制度改革'
              failureCondition: '无'
            6:
              name: '城中村改造货币化安置'
              summary: '100万套货币化安置、政策支持扩至300城；房票安置消化库存；资金=专项债+专项借款；老破小改造遵循你的房子你做主'
              evidence:
                0: '政策组合拳解读2024'
                1: '原拆原建对话2025.10'
              applicationContext: '增量政策评估'
              failureCondition: '无'
            7:
              name: '新普惠金融（公积金改革）'
              summary: '住房金融体系适配不了新时期需求：财政贴息引导非公企业灵活就业缴存、增值收益反哺新市民、公积金升综合民生账户、全国资金调剂机制'
              evidence:
                0: '新普惠金融访谈2026.03'
              applicationContext: '住房金融制度'
              failureCondition: '无'
            8:
              name: '租金回报率3-4%'
              summary: '租金是房价的现金流折现反映，租金不稳必然导致房价不稳；3-4%租金回报率才是合理水平；保租房低租金可能分流市场租赁'
              evidence:
                0: '国有房东降租2025'
                1: '房价判断专题'
              applicationContext: '房价与租赁判断'
              failureCondition: '无'
          blindSpots:
            knownBias:
              0: '以广东省/珠三角经验为主视角'
              1: '政策研究视角对资本市场关注少'
