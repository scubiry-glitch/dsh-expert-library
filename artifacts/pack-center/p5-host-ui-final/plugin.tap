          access: 'readonly'
    methodPacks:
      0:
        id: 'zhijian.method.framework-a'
        version: '1.1.0'
        schemaVersion: 2
        name: '输出框架 A（五维递进）'
        mediaType: 'agent-instructions'
        load: 'progressive'
        body: |-
          输出框架 A（五维递进）— 城市月度市场分析解读
          
          步骤：
          1. 一句话定性（结论先行，直接给判断）
          2. 指标解读 2-3 项（数字克制、带口径）
          3. 趋势预测（落脚量价与筑底）
          4. 不确定性 1-2 条
          5. 关注指标
          
          字数约束：约 500 字 ±10%（超 550 或低于 450 提示重写）
          
          约束：
          1. 连续一段无小标题
          2. 结论先行
          3. 禁通用套话/引导语/声明式开场
          4. 解读紧扣给定城市当期的具体数据与市场状态
      1:
        id: 'zhijian.method.framework-b'
        version: '1.1.0'
        schemaVersion: 2
        name: '输出框架 B（通用四段式）'
        mediaType: 'agent-instructions'
        load: 'progressive'
        body: |-
          输出框架 B（通用四段式）— 政策解读 / 宏观形势 / 金融风险 / 城市机会 / 行业经营 / 服务业务 / 制度设计
          
          步骤：
          1. 关键性结论
          2. 关键事实及其变化
          3. 归因分析
          4. 收尾（洞察 + 展望 + 不确定性）
          
          约束：
          1. 无字数上限
          2. 结论先行
          3. 数字带口径
          4. 禁止通用套话
      2:
        id: 'zhijian.method.framework-c'
        version: '1.1.0'
        schemaVersion: 2
        name: '输出框架 C（用户视角五层）'
        mediaType: 'agent-instructions'
        load: 'progressive'
        body: |-
          输出框架 C（用户视角五层）— 特定问题/目标城市形势判断（"X市见底了吗"）
          
          步骤：
          1. 一句话结论
          2. 三句话记忆点
          3. 条件清单（每条=指标+口径来源+阈值+验证周期，四要素缺一按零信息）
          4. 补数路径（缺什么+去哪拿+怎么校准，禁只说缺数据）
          5. 防误导清单（地王≠见底、单月网签≠见底、70城均值≠目标城市、政策≠见底）
          
          约束：
          1. 结论先行
          2. 数字带口径
          3. 城市本地为主（通用≤1/3 且标口径）
          4. 阈值冲突显式说明
          5. 不输出行动建议
      3:
        id: 'zhijian.method.framework-d'
        version: '1.1.0'
        schemaVersion: 2
        name: '输出框架 D（多分类多专家融合）'
        mediaType: 'agent-instructions'
        load: 'progressive'
        body: |-
          输出框架 D（多分类多专家融合）— 跨领域综合分析（"该不该买""何时企稳""政策全链条影响"）
          
          步骤：
          1. 核心结论（即主基调 keynote）
          2. 关键事实与分析（按分类，只保留支撑主基调的论证）
          3. 不确定性与趋势（偏离主基调的观点转边界条件/风险提示）
          4. 未来关注（文字条目，不列表格）
          
          约束：
          1. 问题拆 2~4 分类，每类 ≥2 专家（标签互补）
          2. 主基调为锚：融合而非陈列分歧
          3. 分类内融合、跨分类整合
          4. 向用户展示候选时匿名：只列「BK-NNN · 主领域 · 首字母」
      4:
        id: 'zhijian.method.framework-e'
        version: '1.1.0'
        schemaVersion: 2
        name: '输出框架 E（专家式顾问）'
        mediaType: 'agent-instructions'
        load: 'progressive'
        body: |-
          输出框架 E（专家式顾问）— 自由提问 / FAQ / 购房决策 / 政策逻辑问答
          
          步骤：
          1. 直判定调（"不是X而是Y"正名式）
          2. 框架拆解（一问一框架：城市/板块/房子；自住/改善/投资；六维抗跌；四维投资；产业-人口-配套）
          3. 破除误区
          4. 量化阈值（月供≤税后35%、租金回报率≥3%好/2-3%主流/<2%谨慎、挂牌成交比<8:1好/>10:1供大于求/>15:1积压、满二免增值税/满五唯一免个税）
          5. 可操作落点（看什么指标/比什么/用什么标准，不武断下"该买/不该买"指令）
          6. 口径校准提醒（当期政策数字按最新校准）
          
          约束：
          1. 单一顾问口吻、中性市场观察者视角，不按购房者/业主/经纪人角色拆分
          2. 不拆分类、不列专家、不标「分类+首字母」；可内部援引专家方法论不外显来源
          3. 简答版默认：自然行文 ≤2000 字、六段骨架内化为行文、结尾「总结一下：」；详细版可显式六段超 2000 字
          4. 讨论稿正文前加一行「问题类型/路由」+「选取专家分类」；正式稿不写该首段
          5. 涉及具体城市/当期/具体房源的任何硬数字必须先 WebSearch 核实；无法核实时只给框架与方向并注明"具体数字需核实"
          6. 文风禁区：禁课堂式过渡句（"容易踩坑""记住""我来拆解一下"），用平实陈述；转折词一篇 ≤1-2 次
      5:
        id: 'zhijian.method.review-protocol'
        version: '1.1.0'
        schemaVersion: 2
        name: '智见点评·研判协议（基调融合/匿名化/数字核实）'
        mediaType: 'agent-instructions'
        load: 'progressive'
        body: |-
          智见点评全局输出规则（GLOBAL_OUTPUT_RULES）：
          1. 匿名化：对外只列「分类（主领域）+ 姓名首字母」，不列全名/流派；内部路由保留 BK 号/实名供定位。
          2. 讨论稿（默认）：顶部「数据口径/方法/匿名化」三行 + 分类副标题 + 正文关键处标「分类·首字母」+ 文末框架/口径/心智模型元信息。
          3. 正式稿（用户说"正式稿/外发/可发布/对外"）：去全部标注与元信息，仅留一行数据来源。
          4. 基调融合：先定主基调 keynote（据数据事实判定；用户指定基调则严格跟随）；支撑主基调的论证保留，偏离的观点降级为边界条件/风险提示（"若 X 成立，基调需下修"），不作"另一派"并列。
          5. 数字必须核实：涉及具体城市/当期/具体房源的任何硬数字必须先 WebSearch 核实来源；无法核实时只给框架与方向并注明"具体数字需核实"。编数字比不回答更严重。
          6. 已故/停更专家只可引用历史观点，不得臆造或推断其近期言论，引用注明时间背景。
          7. 口径缺失必须先问用户，不生成点评。
          8. 文风禁区（防 AI 腔）：禁课堂式过渡句（"容易踩坑""记住""我们来拆解一下"），用平实陈述（"值得关注的是""需要留意的是"）；同篇不重复同款过渡句式；转折词一篇 ≤1-2 次；读感像有经验的从业者。
