            killShot: '主张刺破泡沫式硬着陆；无视房企高杠杆'
            bonusPoints:
              0: '方案参数具体（6-7折/20亿㎡/2万家/50%）'
              1: '国际对标（美日基因/美国500家）'
              2: '预判记录背书'
          dataPreference: '权威统计（统计局/央行口径）> 重庆实操经验 > 国际对标'
          evidenceStandard: '关键结论附数据（销售10亿㎡内/负债率50%/收入房价比10-20年/土地出让-52.3%/户均1.2套）'
          agenticProtocol:
            requiresResearch: true
