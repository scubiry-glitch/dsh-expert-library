# Browser-facing canonical origin. OIDC callbacks will use this origin in S1.
PUBLIC_ORIGIN=https://zhijian.meizu.life

# Server-to-server DSH address. Use a private address or authenticated tunnel
# when the portal and DSH run on different machines. Never expose this value
# to browser JavaScript.
DSH_BACKEND_URL=http://127.0.0.1:3080

# Bind only to the local reverse proxy. A remote deployment may use its own
# private interface, with firewall rules limiting access to that interface.
HOST=127.0.0.1
PORT=18460

# S1 authentication is activated only when all three values are present.
# The issuer supports both developer-center password login and the 智见 account bridge.
# The public S1 login pilot enables these, while research remains disabled until
# an account is explicitly bound to its isolated DSH runtime.
# OIDC_ISSUER=https://packs.meizu.life/oidc
# OIDC_CLIENT_ID=zhijian-customer-portal
# ACCOUNT_DB_PATH=/var/lib/zhijian/customer-portal/accounts.sqlite

# Optional deployment aliases for isolated DSH instances. Bind each customer
# account to one alias in the server-side account store; browsers never select it.
# DSH_BACKENDS_JSON={"customer-a":"http://127.0.0.1:3101"}
# DSH_GATEWAY_TOKEN_DIR=/etc/zhijian/customer-gateway-tokens

# Research stays closed until each isolated backend has passed first-reply,
# restart/recovery, cross-account and usage checks. Only listed aliases can
# create or send sessions; listing another account's existing sessions remains
# governed by its membership. Empty/unset means login-only pilot.
# RESEARCH_ENABLED_BACKENDS=customer-a

# Optional read-only model usage view. Both values are required together.
# The credential file is readable only by the portal and model gateway services.
# MODEL_USAGE_URL=http://127.0.0.1:3190
# MODEL_USAGE_TOKEN_FILE=/etc/zhijian/model-gateway-usage-token
