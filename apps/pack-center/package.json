{
  "name": "@zhijian/pack-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/database.js migrate",
    "test": "npm run build && node --test 'test/*.test.mjs'",
    "test:browser": "npm run build && node --test 'test/browser/*.test.mjs'"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "jose": "6.2.12",
    "playwright-core": "1.55.0",
    "typescript": "5.9.3"
  }
}
