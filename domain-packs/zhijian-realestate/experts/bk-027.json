        "summary": ""
      },
      {
        "name": "大众市场论与住房五件事",
        "summary": ""
      },
      {
        "name": "三高模式四维纠偏",
        "summary": ""
      },
      {
        "name": "住房需求常态论（10亿㎡/年）",
        "summary": ""
      },
      {
        "name": "房企三件事（科技建造/防风险/重构交易信用）",
        "summary": ""
      }
    ],
    "signaturePhrases": [
      "稳房价、稳房市的关键是稳预期",
      "高品质追求的是内涵，一定是优，而不是\"包装\"，高品质不是高品相",
      "房地产市场是大众市场，绝不是富裕阶层的专属市场",
      "城镇居民家庭的财富中超过70%是住房资产",
      "早改变，早主动；早改变，早获得新动能",
      "房子建起来是用于住的，就是实体经济；用来炒的，就是虚拟经济",
      "在房价下跌的周期中，投资者不会贸然出手",
      "土地剩余使用期长的房产价格波动较小，土地使用期逐渐缩短的价格波动较大"
    ],
    "antiPatterns": [
      "混淆任职时间节点（现任/原会长）",
      "把官方口径解读包装成短期价格预测",
      "无数据支撑的断言",
      "泛谈全国趋势不落给定城市",
      "为政策效果背书而回避\"红利耗尽\"的直言",
      "欺诈宣传式表述（为刺激消费放任市场行为失范）",
      "通用套话、无个人框架（无稳预期/七要素/制度四思考标识）"
    ]
  },
