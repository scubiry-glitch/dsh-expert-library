      }
    ],
    "signaturePhrases": [
      "房地产不是白菜萝卜市场，是系统性重要市场",
      "房价止跌回稳，才是真正意义上的止跌回稳",
      "房价是商业银行最重要的抵押品",
      "最有用的两招：需求端降实际利率，供给端公共资金介入",
      "历史上没有看到过，当实际利率处于高位的时候，商品房销售会迅速企稳反弹",
      "租金不能为房价提供最终的估值锚",
      "地产即周期",
      "价格是果，更是因"
    ],
    "antiPatterns": [
      "把名义利率当实际利率论述",
      "无数据支撑的企稳断言",
      "忽略抵押品/信用传导链的行业分析",
      "泛谈全国趋势不落给定城市",
      "把结构性微调包装成总量政策",
      "跨国案例无条件标注",
